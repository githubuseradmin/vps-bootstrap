# ---------------------------------------------------------------------------
# vps-bootstrap — .gitignore
# ---------------------------------------------------------------------------

# Local, machine-specific config (may reference key paths / hostnames).
# The committed template is bootstrap.conf.example; the live file is private.
bootstrap.conf
*.conf.local

# SSH keys — never commit private keys. Public keys are technically safe,
# but ignoring the whole set avoids accidents.
*.pem
*.key
id_*
*_rsa
*_ed25519
*_ecdsa
authorized_keys

# Timestamped backups the script makes before editing system files.
*.bak
*.bak.*

# Logs / transient run output.
*.log
run.log
dry-run.txt

# OS / editor cruft.
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
